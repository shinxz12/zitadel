# syntax=docker/dockerfile:1
# Login UI image for the shared auth service (auth.btngoc.io.vn), built from this fork.
# Build from the repository root:
#   docker build -f apps/login/Dockerfile.smarttech -t zitadel-login:smarttech .
# Differences from upstream: Vietnamese locale, org-domain suffix hidden in displayed login names,
# theme chosen at build time (NEXT_PUBLIC_* are inlined by Next.js).

# The build output is plain JavaScript, so it is built once on the builder's native platform.
FROM --platform=$BUILDPLATFORM node:24-alpine AS build
RUN apk add --no-cache git bash && corepack enable
WORKDIR /src
COPY . .
ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_BASE_PATH=/ui/v2/login \
    NEXT_PUBLIC_HIDDEN_LOGINNAME_DOMAIN=auth.btngoc.io.vn \
    NEXT_PUBLIC_THEME_ROUNDNESS=mid \
    NEXT_PUBLIC_THEME_LAYOUT=side-by-side \
    NEXT_PUBLIC_THEME_SPACING=regular \
    NEXT_PUBLIC_THEME_APPEARANCE=material
RUN pnpm install --frozen-lockfile --filter "@zitadel/login..." --filter "@zitadel/zitadel"
RUN pnpm --filter @zitadel/proto run generate \
 && pnpm --filter @zitadel/client run build \
 && pnpm --filter @zitadel/login run build
RUN mkdir -p /env-file && touch /env-file/.env

# Runtime stage: same layout as apps/login/Dockerfile, but without RUN steps so images for other
# architectures can be assembled without emulation (the stock "node" user replaces "nextjs").
FROM node:24-alpine
WORKDIR /app
COPY --from=build --chown=node:node /env-file /.env-file
COPY --from=build --chown=node:node /src/apps/login/.next/standalone ./
USER node
ENV HOSTNAME="::" \
    PORT="3000" \
    NODE_ENV="production" \
    NODE_OPTIONS="--use-openssl-ca --require /app/load-ssl-cert-dir.cjs" \
    SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt" \
    ZITADEL_TLS_ENABLED="false" \
    OTEL_SERVICE_NAME="zitadel-login" \
    OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/node", "/app/healthcheck.mjs", "/ui/v2/login/ready"]
ENTRYPOINT ["/app/entrypoint.sh", "node", "apps/login/server.js"]
